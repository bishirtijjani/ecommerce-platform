node_modules/
.codegraph/
.env
*.log
logs/
dist/
dist-web/
.expo/
ios/
android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
mysooq-service-account.json
*.service-account.json
*.orig.*
web-build/
.DS_Store
Thumbs.db
.aider*
