# Loaded by Expo at build time (EXPO_PUBLIC_* vars get inlined into the web
# bundle - see src/services/api.js). Without this, the deployed web build
# falls back to http://127.0.0.1:3000, which is meaningless in a browser -
# every API call (including login) silently fails.
EXPO_PUBLIC_API_URL=https://api.mysooq.ng
